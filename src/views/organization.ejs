<%- include('partials/header') %>
<main class="main-container">
    <h1 class="page-title"><%= title %></h1>
    <h2 class="org-title"><%= organizationDetails.name %></h2>
    <img class="org-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

    <p class="section-intro">Description: <%= organizationDetails.description %></p>

    <h3>Service Projects</h3>
    <ul class="card-grid">
        <% projects.forEach(project => { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }) %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
    <div class="organization-actions" style="margin-top: 15px;">
        <a href="/update-organization/<%= organizationDetails.organization_id %>" class="btn btn-primary" style="text-decoration: none;">Edit Organization</a>
    </div>
    <% } %>
</main>
<%- include('partials/footer') %>
