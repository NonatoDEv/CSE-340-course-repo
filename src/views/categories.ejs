<%- include('partials/header') %>
    <main class="main-container">
        <h1 class="page-title"><%= title %></h1>
        <ul class="card-grid">
            <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
            <li class="card text-card">
                <a href="/category/<%= category.category_id %>"><%= category.name %></a>
            </li>
            <% }); %>
            <% } 
            else { %>
            <li class="card text-card">No categories found</li>
            <% } %>
        </ul>
        <div class="organization-actions" style="margin-top: 15px; margin-bottom: 15px; position: relative; z-index: 10;">
            <a href="/new-category" class="btn btn-primary" style="display: inline-block; text-decoration: none;">Add a New Category</a>
        </div>
    </main>
<%- include('partials/footer') %>