<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-container">
    
    <div class="form-group">
      <label for="title">Project Title</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        value="<%= project.project_title %>" 
        required 
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" required><%= project.description %></textarea>
    </div>

    <div class="form-group">
    <label for="location">Location</label>
    <input
        type="text"
        id="location"
        name="location"
        value="<%= project.location %>"
        placeholder="e.g., 742 Evergreen Terrace, Springfield"
        maxlength="255"
        required
      />
    </div>

    <div class="form-group">
      <label for="start_date">Start Date</label>
      <input 
        type="date" 
        id="start_date" 
        name="date" 
        value="<%= project.formatted_date || '' %>" 
        required 
      />
    </div>

    <div class="form-group">
      <label for="organization_id">Organization</label>
      <select id="organization_id" name="organizationId" required>
        <option value="">Select an organization</option>
        <% organizations.forEach(org => { %>
          <option 
            value="<%= org.organization_id %>" 
            <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
            <%= org.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <button type="submit" class="btn btn-primary">Update Project</button>
    <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
  </form>
</main>

<%- include('partials/footer') %>