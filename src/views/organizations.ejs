<%- include('partials/header') %>
    <main class="main-container">
        <h1 class="page-title"><%= title %></h1>
        <p class="section-intro">Here are a few of our partner organizations:</p>

        <ul class="card-grid">
            <% organizations.forEach(organization => { %>
                <li class="card org-card">
                    <img class="org-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <strong class="org-title"><%= organization.name %></strong>
                    <a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>
                    <span class="org-email"><%= organization.contact_email %></span>
                </li>
            <% }); %>
        </ul>
        <div class="organization-actions" style="margin-top: 15px; margin-bottom: 15px;">
            <button class="btn btn-primary">
                <a href="/new-organization" style="color: white; text-decoration: none;">Add a New Organization</a>
            </button>
        </div>    
    </main>
<%- include('partials/footer') %>