<%- include('partials/header') %>
    <main class="main-container">
        <h1 class="page-title"><%= title %></h1>
        <h2 class="sub-title">Upcoming Service Projects</h2>

        <ul class="card-grid">
            <% projects.forEach((project) => { %>
            <li class="card text-card">
                <p>
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>: 
                    <strong>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </strong> 
                    (<%= project.organization_name %>)
                </p>
            </li>
            <% }); %>
        </ul>
        <% if (user && user.role_name === 'admin') { %>
        <div class="organization-actions" style="margin-top: 15px; margin-bottom: 15px;">
            <a href="/new-project" class="btn btn-primary" style="text-decoration: none;">Add a New Service Project</a>
        </div>
        <% } %>
    </main>
<%- include('partials/footer') %>