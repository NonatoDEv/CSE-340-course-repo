<%- include('partials/header') %>
    <main class="main-container">
        <h1 class="page-title"><%= title %></h1>
        <h2 class="sub-title">Upcoming Service Projects</h2>

        <ul class="card-grid">
            <% projects.forEach((project) => { %>
            <li class="card text-card">
                <p>
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>: 
                    <strong>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </strong> 
                    (<%= project.organization_name %>)
                </p>
            </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>