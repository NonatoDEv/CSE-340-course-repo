<%- include('partials/header') %>
    <main class="main-container">
        <h1 class="page-title"><%= title %></h1>
        <div class="project-detail-wrapper">
            <h2><%= project.title || project.project_title %></h2>
            <div class="project-meta-info">
                <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><strong>Partner Organization:</strong> 
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>
                <p><strong>Categories:</strong> 
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach((category, index) => { %>
                            <a href="/category/<%= category.category_id %>"><%= category.name %></a><%= index < categories.length - 1 ? ', ' : '' %>
                        <% }); %>
                    <% } else { %>
                        <span>No categories assigned</span>
                    <% } %>
                </p>
            </div>
            <% if (user && user.role_name === 'admin') { %>
            <div class="category-management" style="margin-top: 15px;">
                <a href="/assign-categories/<%= project.project_id || project.id %>" class="btn btn-primary" style="text-decoration: none;">Manage Categories</a>
            </div>
            <% } %>
            <hr class="project-divider">
            <div class="project-description">
                <h3>About this project</h3>
                <p><%= project.description %></p>
            </div>
            <% if (locals.user) { %>
                <hr class="project-divider">
                <div class="volunteer-actions" style="margin-top: 20px; padding: 15px; background-color: #f9f9f9; border-radius: 8px;">
                    
                    <% if (locals.isUserVolunteered) { %>
                        <p style="color: green; font-weight: bold;">You are volunteering for this project.</p>
                        
                        <form action="/volunteer/remove/<%= project.project_id || project.id %>" method="POST">
                            <button type="submit" class="btn btn-danger">Remove me as a volunteer</button>
                        </form>
                    <% } else { %>
                        <form action="/volunteer/add/<%= project.project_id || project.id %>" method="POST">
                            <button type="submit" class="btn btn-primary">Volunteer for this project</button>
                        </form>
                    <% } %>
                    
                </div>
            <% } %>
    
        </div>

        <% if (user && user.role_name === 'admin') { %>
        <div class="project-actions" style="margin-top: 15px;">
            <a href="/edit-project/<%= project.project_id || project.id %>" class="btn btn-primary" style="text-decoration: none;">Edit Project</a>
        </div>
        <% } %>


    </main>
<%- include('partials/footer') %>